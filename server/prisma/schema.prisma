// ============================================================
// Prisma schema
//
// 生成 Client：npx prisma generate
// 数据库已用 prisma/init.sql 初始化（含 admin 账号）
//
// 字段映射约定（Prisma → MySQL 实际列名）：
//   · camelCase 字段名 → @map("snake_case")
//   · 表名（model 名 PascalCase）→ @@map("lowercase_snake")
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  // 逻辑外键：Prisma 不生成 MySQL FOREIGN KEY 约束，只建普通 INDEX
  // @relation / include / cascade referential integrity 全部照常工作
  relationMode = "prisma"
}

/// 博主账号表
model User {
  /// 主键 id（自增，前端 UserProfile.id）
  id        Int      @id @default(autoincrement())
  /// 登录用户名（唯一）
  username  String   @unique @db.VarChar(50)
  /// bcrypt 加密的密码（不返回前端）
  password  String   @db.VarChar(100)
  /// 昵称 → About 展示 name 直接复用
  nickname  String?  @db.VarChar(50)
  /// 邮箱
  email     String?  @db.VarChar(100)
  /// 头像URL → About 展示头像直接复用
  avatar    String?  @db.VarChar(500)
  /// 角色：admin / guest
  role      String   @default("admin") @db.VarChar(20)
  /// 状态：1=正常 0=禁用
  status    Int      @default(1) @db.TinyInt
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  // ===== About 公开资料（AboutPage / HomePage / DraggableWidget 公开展示用） =====
  /// 短简介（About 副标题 / Home Hero 简介）
  aboutShortBio     String   @default("") @db.VarChar(300)  @map("about_short_bio")
  /// 长文介绍段落数组（About "关于我" section）string[] → JSON
  aboutLongBio      Json     @default("[]")                 @map("about_long_bio")
  /// 技能分组（proficient / familiar / tools ...）→ SkillGroup[] JSON
  aboutSkills       Json     @default("[]")                 @map("about_skills")
  /// 4 个高亮数字统计 chip → {label:string, value:string}[] JSON
  aboutHighlightStats Json  @default("[]")                 @map("about_highlight_stats")
  /// 兴趣标签 chips → string[] JSON
  aboutInterests    Json     @default("[]")                 @map("about_interests")
  /// Hero 终端"方向：xxx / yyy / ..." → string[] JSON（约定 4 项）
  aboutTags         Json     @default("[]")                 @map("about_tags")
  /// 位置（MapPin 图标显示，如"中国 · 远程协作友好（UTC+8）"）
  aboutLocation     String   @default("") @db.VarChar(100)  @map("about_location")
  /// 当前是否可接单 → 绿色成功 / 灰色排期满
  aboutAvailable    Boolean  @default(true)                 @map("about_available")
  /// 现在在做什么 Card 条目数组 → string[] JSON（支持 **粗体** inline markdown 语法）
  aboutNowDoing     Json     @default("[]")                 @map("about_now_doing")

  // ===== About 热力图配置（Contribution 模块 A/B/D 方案控制用） =====
  /// 默认显示源：SITE 本站 / GITHUB / MERGED（方案 D 三态）
  aboutHeatmapSource       String   @default("MERGED") @db.VarChar(20)   @map("about_heatmap_source")
  /// 是否启用 GitHub 贡献（默认 true，游客 About 页可以看到 GitHub Tab）
  aboutHeatmapEnableGithub Boolean  @default(true)                       @map("about_heatmap_enable_github")
  /// 博主 GitHub 用户名（公开，游客 About 页能看到）
  aboutGithubUsername      String   @default("TE-Fire") @db.VarChar(100) @map("about_github_username")
  /// 博主 GitHub 主页链接
  aboutGithubLink          String   @default("https://github.com/TE-Fire") @db.VarChar(500) @map("about_github_link")

  // ===== Post 模块关联 =====
  posts       Post[]
  categories  Category[]

  @@map("user")
}

/// 文章发布状态（软删除：ARCHIVED 不公开，但保留热力图贡献计数）
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// 文章分类（严格关系模型：Post.category_id 外键关联）
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  /// 排序号：Category 列表前端按此从小到大排
  sort      Int      @default(0) @db.Int
  authorId  Int      @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// 分类下的文章
  posts     Post[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@map("category")
}

/// 文章标签（严格关系模型：Tag 全局唯一，renameTag 只需要 UPDATE 一行）
model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  /// 文章-标签 多对多关联
  posts     PostTag[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tag")
}

/// 文章表（主体）· 正文存 MySQL TEXT，不额外拆 key-value
model Post {
  /// 主键
  id          Int       @id @default(autoincrement())
  /// 路由用 slug（唯一，URL 友好）
  slug        String    @unique @db.VarChar(200)
  /// 标题
  title       String    @db.VarChar(300)
  /// 摘要（不填时自动取 content 前 200 字）
  excerpt     String    @default("") @db.VarChar(500)
  /// Markdown 正文（TEXT 64KB，足够 3000 字的文章 ×20，够用后续 ALTER 成 LONGTEXT）
  content     String    @db.Text
  /// 封面图 URL（可选；若本地上传使用 DataURL，最长可达 10MB+ 级别，因此使用 LongText）
  cover       String?   @db.LongText
  /// 首页精选：HomePage / 列表页 highlight 高亮
  featured    Boolean   @default(false)
  /// 发布状态（DRAFT 草稿 / PUBLISHED 已发布 / ARCHIVED 软删）
  status      PostStatus @default(DRAFT)
  /// 阅读字数（保存时自动计算，列表 / 详情页展示用）
  wordCount   Int       @default(0)                    @map("word_count")
  /// 预估阅读分钟数（= max(1, ceil(wordCount/500))，保存时自动计算）
  readMinutes Int       @default(1)                    @map("read_minutes")

  /// 作者
  authorId   Int        @map("author_id")
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// 分类（外键）
  categoryId Int?       @map("category_id")
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// 标签（多对多）
  tags       PostTag[]

  /// 创建时间：PUBLISHED 时用于博客发布时间 & 热力图计数
  createdAt DateTime @default(now()) @map("created_at")
  /// 最后修改时间
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@index([createdAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("post")
}

/// Post ↔ Tag 多对多中间表（显式定义，方便后续加 tagOrder 这类字段）
model PostTag {
  postId    Int
  tagId     Int
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tag")
}

// ============================================================
// 模块七：Life 生活碎片
// 单表多态：PHOTO/MUSIC/ESSAY/FOOTPRINT/BOOKNOTE 共用 life_moment
// life_album 为相册扩展预留表（1:N）
// ============================================================

/// 生活碎片类型
enum LifeMomentType {
  PHOTO       // 照片
  MUSIC       // 音乐
  ESSAY       // 随笔
  FOOTPRINT   // 足迹打卡
  BOOKNOTE    // 书影笔记
}

/// 碎片发布状态（同 Post 软删除模式）
enum LifeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// 相册表（为"照片相册/图集"扩展预留）
model LifeAlbum {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  coverUrl    String?  @db.LongText       @map("cover_url")
  sortOrder   Int      @default(0)        @map("sort_order")
  createdAt   DateTime @default(now())    @map("created_at")
  updatedAt   DateTime @updatedAt          @map("updated_at")
  moments     LifeMoment[]

  @@map("life_album")
}

/// 生活碎片表（单表多态）
model LifeMoment {
  id          Int             @id @default(autoincrement())
  type        LifeMomentType
  status      LifeStatus      @default(PUBLISHED)

  // ===== 通用字段 =====
  title       String?         @db.VarChar(200)            // 照片/音乐/足迹标题；随笔可空
  content     String?         @db.Text                     // 随笔正文 / 照片描述 / 书影短评
  date        DateTime                                     // 碎片发生日期（用于时间轴排序）
  mood        String?         @db.VarChar(20)             // 心情标签
  sortOrder   Int             @default(0)    @map("sort_order")
  featured    Boolean         @default(false)              // 首页精选

  // ===== 媒体字段（本地 public/uploads/life/ 路径，预留 MinIO/OSS）=====
  mediaUrl    String?         @db.LongText                 // 文件路径（照片/音频）
  mediaType   String?         @db.VarChar(50)              // MIME type: image/jpeg, audio/mpeg
  thumbnailUrl String?       @db.LongText    @map("thumbnail_url") // 音乐封面 / 书影封面

  // ===== 渐变色块 fallback（无图时占位）=====
  gradientFrom String?        @db.VarChar(20) @map("gradient_from")
  gradientTo   String?        @db.VarChar(20) @map("gradient_to")
  coverColor   String?        @db.VarChar(20) @map("cover_color")  // 音乐封面色

  // ===== 音乐专属 =====
  artist      String?         @db.VarChar(100)
  playCount   Int             @default(0)    @map("play_count")
  externalLink String?        @db.LongText    @map("external_link")  // 网易云/QQ音乐外链
  comment     String?         @db.VarChar(500)               // 一句话点评

  // ===== 书影专属 =====
  bookAuthor  String?         @db.VarChar(100) @map("book_author")
  rating      Int?                                         // 1~5 星评分
  bookType    String?         @db.VarChar(10)  @map("book_type") // "book" | "movie"

  // ===== 布局字段（照片瀑布流）=====
  span        Int             @default(1)                   // 1=正常, 2=宽卡
  heightKey   String          @default("md") @db.VarChar(4) @map("height_key") // sm/md/lg/xl

  // ===== 扩展预留 =====
  albumId     Int?            @map("album_id")
  album       LifeAlbum?      @relation(fields: [albumId], references: [id], onDelete: SetNull)

  geoLat      Float?          @map("geo_lat")               // 纬度（地图足迹）
  geoLng      Float?          @map("geo_lng")               // 经度（地图足迹）
  locationName String?        @db.VarChar(200) @map("location_name") // 地名

  // ===== 基础 =====
  createdAt   DateTime        @default(now())  @map("created_at")
  updatedAt   DateTime        @updatedAt        @map("updated_at")

  @@index([type])
  @@index([status])
  @@index([date])
  @@index([albumId])
  @@map("life_moment")
}
