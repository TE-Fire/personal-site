# ==============================
# 应用服务
# ==============================
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ==============================
# 博主凭据（阶段一：不依赖数据库）
# ==============================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NICKNAME=TE-Fire
ADMIN_EMAIL=admin@example.com
ADMIN_AVATAR=

# ==============================
# 数据库（MySQL，阶段二接入）
# ==============================
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/personal_site?useUnicode=true&characterEncoding=utf8mb4"

# ==============================
# JWT
# ==============================
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d

# ==============================
# Redis（后续接入）
# ==============================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==============================
# CORS
# ==============================
CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175
