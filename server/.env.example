# ==============================
# 应用服务
# ==============================
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ==============================
# 数据库（MySQL）
# ==============================
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/personal_site?useUnicode=true&characterEncoding=utf8mb4"

# ==============================
# JWT
# ==============================
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d

# ==============================
# Redis（后续接入）
# ==============================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==============================
# CORS
# ==============================
CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175
